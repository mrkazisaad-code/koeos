---
import Arrow from './Arrow.astro';
import { NAV_LINKS } from '../config/site';
---
<a class="skip-link" href="#what">Skip to content</a>
<header class="site-header" data-header>
  <div class="container site-header__bar">
    <a class="wordmark" href="#top" aria-label="Koeos, back to top">KOEOS</a>
    <nav class="site-nav" aria-label="Primary">
      <ul>
        {NAV_LINKS.map((l) => (
          <li><a href={l.href} data-nav-link>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="btn btn--primary btn--small site-header__cta" href="#contact">Start a conversation<Arrow /></a>
    <button type="button" class="menu-btn" aria-haspopup="dialog" aria-controls="menu" aria-expanded="false" data-menu-open hidden>
      <span class="sr-only">Open menu</span>
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M3 8h18M3 16h18" stroke="currentColor" stroke-width="1.6" fill="none" /></svg>
    </button>
    <noscript><a class="menu-btn menu-btn--fallback" href="#footer-nav">Menu</a></noscript>
  </div>
  <div class="site-header__progress" aria-hidden="true"><span data-progress></span></div>
</header>

<dialog class="menu" id="menu" aria-label="Menu" data-menu>
  <div class="menu__inner">
    <div class="menu__top">
      <span class="wordmark" aria-hidden="true">KOEOS</span>
      <button type="button" class="menu-btn" data-menu-close>
        <span class="sr-only">Close menu</span>
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.6" fill="none" /></svg>
      </button>
    </div>
    <nav aria-label="Menu">
      <ul class="menu__links">
        {NAV_LINKS.map((l) => (
          <li><a href={l.href} data-menu-link><span class="menu__num" aria-hidden="true">{l.num}</span>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="btn btn--primary menu__cta" href="#contact" data-menu-link>Start a conversation<Arrow /></a>
  </div>
</dialog>

<style is:global>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      transform var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  .site-header.is-scrolled {
    background: rgb(11 17 19 / 0.85);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--line-700);
  }
  /* Hidden: slide up but keep the 2px reading-progress line in view */
  .site-header.is-hidden {
    transform: translateY(calc(-100% + 2px));
  }
  .site-header__bar {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--s-6);
  }
  .wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.08em;
    color: var(--text-100);
    text-decoration: none;
    line-height: 1;
    padding-block: 12px;
  }
  .wordmark:hover {
    color: var(--text-100);
  }
  .site-nav {
    display: none;
    margin-inline: auto;
  }
  .site-nav ul {
    display: flex;
    gap: var(--s-6);
  }
  .site-nav a {
    position: relative;
    display: inline-block;
    padding-block: 10px;
    font-size: 15px;
    line-height: 1.2;
    color: var(--text-300);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 2px;
    background: var(--copper-400);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .site-nav a:hover {
    color: var(--text-100);
  }
  .site-nav a[aria-current='true'] {
    color: var(--text-100);
  }
  .site-nav a[aria-current='true']::after {
    transform: scaleX(1);
  }
  .site-header__cta {
    display: none;
  }
  .menu-btn {
    margin-left: auto;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 1px solid var(--line-700);
    border-radius: 2px;
    color: var(--text-100);
  }
  .menu-btn:not([hidden]) {
    display: inline-grid;
  }
  .menu-btn--fallback {
    width: auto;
    padding-inline: 12px;
    font-size: 14px;
    text-decoration: none;
  }
  .site-header__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    pointer-events: none;
  }
  .site-header__progress span {
    display: block;
    height: 100%;
    background: var(--copper-400);
    transform: scaleX(0);
    transform-origin: left;
  }
  @media (min-width: 1024px) {
    .site-nav,
    .site-header__cta {
      display: block;
    }
    .site-header__cta {
      display: inline-flex;
    }
    .site-header__bar .menu-btn,
    .site-header__bar noscript {
      display: none !important;
    }
  }

  /* Mobile menu: full-screen panel */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--ink-950);
    color: var(--text-100);
  }
  .menu::backdrop {
    background: var(--ink-950);
  }
  .menu[open] {
    animation: menu-in var(--dur-base) var(--ease-out);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }
  .menu__inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding: 0 var(--margin) var(--s-7);
  }
  .menu__top {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .menu__links {
    margin-top: var(--s-7);
    border-top: 1px solid var(--line-700);
  }
  .menu__links a {
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--line-700);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.2;
    color: var(--text-100);
    text-decoration: none;
  }
  .menu__num {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--teal-300);
    min-width: 2ch;
  }
  .menu__cta {
    margin-top: var(--s-7);
    align-self: flex-start;
  }
</style>
