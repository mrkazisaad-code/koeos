---
const counters = [
  { value: '20+', label: 'years each, building, investing and leading' },
  { value: '25+', label: 'companies founded, built or backed' },
  { value: '€200m+', label: 'raised or advised' },
  { value: '12+', label: 'exits and transactions' },
  { value: '4', label: 'regions: Europe, the Middle East, South Asia and the US' },
];
// Two rows of four. No card names a person, company, fund or acquirer, and cards carry no dates.
const experience = [
  {
    title: 'Logistics procurement software',
    text: 'Built the product organisation and strategy as the company prepared for acquisition, including its first AI procurement product.',
  },
  {
    title: 'A major professional services firm in Luxembourg',
    text: 'Led service-delivery transformation and a GenAI team, shaped the AI operating model across the Luxembourg firm, and led the team behind an approved internal AI investment case.',
  },
  { title: 'Cloud and digital services', text: 'Ran product and innovation, turning services into products customers could buy.' },
  { title: 'Business process outsourcing', text: 'Founded the business and grew it to 100+ people.' },
  {
    title: 'Technology venture capital',
    text: 'Invested in technology businesses at a European VC firm and supported founders through financing, growth and strategic decisions.',
  },
  {
    title: 'Boards and strategic advice',
    text: 'Advised founders, leadership teams and shareholders on strategy, financing and organisation, as investor, CEO and board member.',
  },
  {
    title: 'Fundraising and transactions',
    text: 'Prepared technology and industrial businesses for financial and strategic investors, financing rounds and M&A.',
  },
  {
    title: 'Deep technology and strategic sectors',
    text: 'Commercial positioning and routes to scale for robotics, AI, biotechnology and advanced-industry ventures, including defence and security, where technology is judged against mission requirements and operational effect.',
  },
];
---
<section class="section section--alt record" id="record" aria-labelledby="record-title">
  <div class="container">
    <p class="eyebrow" data-reveal>10 · <span class="eyebrow__rest">TRACK RECORD</span></p>
    <h2 class="h2" id="record-title" data-reveal style="--i:1">We have built products and companies, run large operations, and invested in technology.</h2>

    <ul class="record__counters" data-counter-group>
      {counters.map((c, i) => (
        <li class="counter" style={`--i:${i}`}>
          <span class="big-number counter__num" data-count>{c.value}</span>
          <span class="counter__rule" aria-hidden="true"></span>
          <span class="counter__label">{c.label}</span>
        </li>
      ))}
    </ul>
    <p class="caption record__counters-note" data-reveal>Combined experience of the Koeos partners.</p>

    <ul class="record__cards">
      {experience.map((e, i) => (
        <li class="card record-card" data-reveal style={`--i:${i}`}>
          <h3 class="h3">{e.title}</h3>
          <p class="body">{e.text}</p>
        </li>
      ))}
    </ul>

    <p class="caption record__note" data-reveal>Client, employer, fund and acquirer names are withheld.</p>
  </div>
</section>

<style is:global>
  .record__counters {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-7) var(--gutter);
    margin-top: var(--s-8);
  }
  .counter {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }
  .counter:last-child {
    grid-column: 1 / -1;
    justify-self: center;
    width: calc(50% - var(--gutter) / 2);
  }
  .counter__num {
    min-width: 3ch;
  }
  .counter__rule {
    display: block;
    width: 48px;
    height: 1px;
    background: var(--copper-400);
    transform-origin: left;
  }
  .counter__label {
    color: var(--text-300);
    font-size: 15px;
    line-height: 1.45;
    max-width: 22ch;
  }
  .js.motion .record__counters .counter__rule {
    transform: scaleX(0);
    transition: transform var(--dur-slow) var(--ease-in-out);
    transition-delay: calc(var(--i) * var(--stagger));
  }
  .js.motion .record__counters.is-counted .counter__rule {
    transform: none;
  }
  .record__counters-note {
    margin-top: var(--s-6);
  }
  .record__cards {
    display: grid;
    gap: var(--gutter);
    margin-top: var(--s-8);
  }
  .record-card {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .record__note {
    margin-top: var(--s-6);
  }
  @media (min-width: 768px) {
    /* Columns grow to fit the widest figure (€200m+) instead of letting it overrun */
    .record__counters {
      grid-template-columns: repeat(5, minmax(min-content, 1fr));
    }
    .counter:last-child {
      grid-column: auto;
      justify-self: stretch;
      width: auto;
    }
    .record__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .record__cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
