---
import Arrow from '../Arrow.astro';
import { CONTACT_EMAIL, CONTACT_ENDPOINT, LINKEDIN_URL } from '../../config/site';
const options = [
  'Investor or venture builder',
  'Group entering Europe',
  'Large enterprise',
  'Professional-services firm',
  'Founder or research team',
  'Other',
];
---
<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container grid-12 contact__body">
    <div class="contact__intro">
      <p class="eyebrow" data-reveal>11 — <span class="eyebrow__rest">CONTACT</span></p>
      <h2 class="h2" id="contact-title" data-reveal style="--i:1">Tell us what should be earning and isn’t.</h2>
      <p class="lead contact__text" data-reveal style="--i:2">A product without customers, a market you want to enter, an AI programme that has not paid back. Send a few lines. We reply within two business days.</p>
      <dl class="contact__details" data-reveal style="--i:3">
        <div><dt>Email</dt><dd><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></dd></div>
        <div><dt>Location</dt><dd>Luxembourg</dd></div>
        <div><dt>LinkedIn</dt><dd><a href={LINKEDIN_URL} rel="noopener noreferrer" target="_blank">linkedin.com/company/koeos-ventures<span class="sr-only"> (opens in a new tab)</span></a></dd></div>
      </dl>
    </div>

    <div class="contact__card" data-reveal style="--i:2">
      <form class="form" action={CONTACT_ENDPOINT} method="post" novalidate data-contact-form>
        <div class="field">
          <label for="f-name">Name</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="200" aria-describedby="f-name-err" />
          <p class="field__error" id="f-name-err" aria-live="polite"></p>
        </div>
        <div class="field">
          <label for="f-org">Organisation</label>
          <input id="f-org" name="organisation" type="text" autocomplete="organization" required maxlength="200" aria-describedby="f-org-err" />
          <p class="field__error" id="f-org-err" aria-live="polite"></p>
        </div>
        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="254" aria-describedby="f-email-err" />
          <p class="field__error" id="f-email-err" aria-live="polite"></p>
        </div>
        <div class="field">
          <label for="f-start">Where are you starting from? <span class="field__opt">Optional</span></label>
          <div class="select">
            <select id="f-start" name="starting_point">
              <option value="">Choose one</option>
              {options.map((o) => <option value={o}>{o}</option>)}
            </select>
            <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          </div>
        </div>
        <div class="field">
          <label for="f-msg">What should be earning and isn’t?</label>
          <textarea id="f-msg" name="message" rows="4" required maxlength="1500" aria-describedby="f-msg-count f-msg-err"></textarea>
          <div class="field__meta">
            <p class="field__error" id="f-msg-err" aria-live="polite"></p>
            <p class="field__count" id="f-msg-count"><span data-count-now>0</span> / 1,500<span class="sr-only"> characters</span></p>
          </div>
        </div>
        <div class="hp" aria-hidden="true">
          <label for="f-website">Leave this field empty</label>
          <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <p class="form__status" role="status" aria-live="polite" data-form-status></p>
        <button class="btn btn--primary form__submit" type="submit">Send<Arrow /></button>
        <p class="form__consent">We use your details only to reply to you. <a href="/privacy/">Privacy notice</a></p>
      </form>
      <div class="form__success" tabindex="-1" hidden data-form-success>
        <p>Thank you. We will reply within two business days.</p>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .contact__body {
    row-gap: var(--s-8);
  }
  .contact__intro .h2 {
    margin-bottom: var(--s-5);
  }
  .contact__details {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line-700);
  }
  .contact__details div {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: var(--s-4);
    align-items: baseline;
  }
  .contact__details dt {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-500);
  }
  .contact__details dd {
    color: var(--text-100);
    word-break: break-word;
  }
  .contact__card {
    background: var(--ink-800);
    border: 1px solid var(--line-700);
    border-radius: 4px;
    padding: var(--s-5);
    align-self: start;
  }
  @media (min-width: 768px) {
    .contact__card {
      padding: var(--s-7);
    }
  }
  @media (min-width: 1024px) {
    .contact__intro {
      grid-column: 1 / span 5;
    }
    .contact__card {
      grid-column: 7 / span 6;
    }
  }

  .form {
    display: grid;
    gap: var(--s-5);
  }
  .field {
    display: grid;
    gap: var(--s-2);
  }
  .field label {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-100);
  }
  .field__opt {
    margin-left: var(--s-2);
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-500);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 12px 14px;
    background: var(--ink-950);
    border: 1px solid var(--line-700);
    border-radius: 2px;
    color: var(--text-100);
    font-size: 16px;
    line-height: 1.5;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .field textarea {
    resize: vertical;
    min-height: calc(4 * 1.5em + 26px);
  }
  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    border-color: var(--text-500);
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--teal-300);
  }
  .field [aria-invalid='true'] {
    border-color: var(--copper-200);
    border-left-width: 3px;
  }
  .select {
    position: relative;
  }
  .select select {
    appearance: none;
    padding-right: 40px;
  }
  .select svg {
    position: absolute;
    right: 16px;
    top: 50%;
    margin-top: -6px;
    color: var(--text-300);
    pointer-events: none;
  }
  .field__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
  }
  .field__error {
    font-size: 14px;
    line-height: 1.4;
    color: var(--copper-200);
  }
  .field__error:empty {
    display: none;
  }
  .field__error::before {
    content: '! ';
    font-family: var(--font-mono);
    font-weight: 500;
  }
  .field__count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    color: var(--text-500);
    white-space: nowrap;
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form__status {
    font-size: 14px;
    color: var(--copper-200);
  }
  .form__status:empty {
    display: none;
  }
  .form__submit {
    justify-self: start;
    min-width: 140px;
    justify-content: space-between;
  }
  .form__submit[aria-busy='true'] {
    opacity: 0.7;
    cursor: progress;
  }
  .form__consent {
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-500);
  }
  .form__consent a {
    color: var(--text-300);
  }
  .form__success {
    padding-block: var(--s-6);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-h3);
    line-height: 1.3;
    color: var(--text-100);
    border-top: 2px solid var(--copper-400);
    padding-top: var(--s-6);
  }
  .form__success:focus {
    outline: none;
  }
</style>
