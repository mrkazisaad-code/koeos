---
const cards = [
  {
    n: '01',
    title: 'Find where it pays',
    text: 'What should this technology improve: revenue, cost, capacity, quality or the customer’s outcome? We find the case worth paying for before anything is built.',
    tags: ['Problem selection', 'Value case', 'AI opportunity assessment', 'Outcome metrics'],
  },
  {
    n: '02',
    title: 'Build the product or offer',
    text: 'Turn the case into something people use or customers buy. We have built product organisations and shipped products, and we build with AI-assisted engineering so decisions rest on something that works.',
    tags: ['Product strategy', 'Product organisation', 'Offer design', 'Outcome pricing', 'Prototypes and AI agents'],
  },
  {
    n: '03',
    title: 'Build the operating model',
    text: 'Make delivery repeatable and the economics hold. In professional services and large enterprises, this often means turning expertise into services partly delivered by AI.',
    tags: ['AI-native operating model', 'Service design', 'Adoption and roles', 'Controls for regulated firms', 'Verification of AI output', 'Pilot to production'],
  },
  {
    n: '04',
    title: 'Build the route to scale',
    text: 'Adoption inside the organisation, customers in the market, capital to grow, or a new market in Europe.',
    tags: ['Go-to-market', 'Investment readiness', 'Fundraising and M&A preparation', 'Market entry', 'Partners', 'Venture building'],
  },
];
---
<section class="section what" id="what" aria-labelledby="what-title" tabindex="-1">
  <svg class="what__line" role="img" aria-label="One line runs through the four steps in order, from 01 to 04, and ends in a result: four steps from technology to value, one continuous piece of work." data-line-svg>
    <path class="what__line-path" data-line-path d="" />
    <circle class="what__line-dot" r="5" cx="-20" cy="-20" data-line-dot />
  </svg>
  <div class="container">
    <p class="eyebrow" data-reveal>03 · <span class="eyebrow__rest">WHAT WE DO</span></p>
    <div class="grid-12 what__body">
      <div class="what__head section-head">
        <h2 class="h2" id="what-title" data-reveal style="--i:1">Four steps from technology to value. AI runs through all of them.</h2>
        <p class="lead" data-reveal style="--i:2">Every engagement runs along the same line: the value case, the product or offer, the operating model, the route to scale. Most start at one point and draw on all four.</p>
      </div>
      <ol class="what__cards" data-line-cards>
        {cards.map((c) => (
          <li class="card card--hover what-card" data-line-card>
            <span class="card__num what-card__num" data-line-num aria-hidden="true">{c.n}</span>
            <div class="what-card__body">
              <h3 class="h3">{c.title}</h3>
              <p class="body what-card__text">{c.text}</p>
              <ul class="tags" aria-label="Offerings">
                {c.tags.map((t) => <li class="tag">{t}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style is:global>
  .what:focus {
    outline: none;
  }
  .what__line {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    overflow: visible;
  }
  .what__line-path {
    fill: none;
    stroke: var(--teal-500);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .what__line-dot {
    fill: var(--copper-400);
  }
  .what__body {
    row-gap: var(--s-7);
  }
  .what__cards {
    display: grid;
    gap: var(--gutter);
  }
  .what-card {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    column-gap: var(--s-3);
  }
  .what-card__num {
    position: relative;
    z-index: 2;
    justify-self: center;
    align-self: start;
    background: var(--ink-800);
    padding: 4px 2px;
    margin-top: -4px;
    line-height: 1.3;
  }
  .what-card__body {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .what-card .tags {
    margin-top: var(--s-3);
  }
  /* Cards wait for the line (A4) when motion is on */
  .js.motion .what-card {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .js.motion .what-card.is-in {
    opacity: 1;
    transform: none;
  }
  .js.motion .what__line-dot {
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .js.motion .what__line.is-done .what__line-dot {
    opacity: 1;
  }
  :root:not(.js) .what__line {
    display: none;
  }

  @media (min-width: 768px) {
    .what__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 1fr;
    }
    .what-card {
      display: flex;
      flex-direction: column;
      gap: var(--s-5);
    }
    .what-card__num {
      align-self: flex-start;
      margin-left: -6px;
      padding: 2px 6px;
      margin-top: -2px;
    }
  }
  @media (min-width: 1024px) {
    .what__head {
      grid-column: 1 / span 5;
      align-self: start;
    }
    .what__cards {
      grid-column: 6 / span 7;
    }
  }
</style>
