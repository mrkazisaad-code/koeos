---
import Arrow from '../Arrow.astro';
const words = 'We make technology pay.'.split(' ');
const tags = [
  'Product strategy',
  'Go-to-market',
  'Outcome pricing',
  'Market entry',
  'Operating models',
  'AI agents',
  'Venture building',
  'Research IP',
  'Governance',
  'Product organisation',
  'Service design',
];
// A1 geometry, shared by the canvas (src/scripts/hero-field.ts) and this static fallback.
// Gates as fractions of the box width; revenue curve x = 0.74 + 0.24h, y = 0.70 - 0.28 * h²(1.4 - 0.4h).
const gates = [0.18, 0.36, 0.54, 0.72];
const gateLabels = ['CHOOSE', 'TEST', 'BUILD', 'SCALE'];
const curveY = (h: number) => 0.7 - 0.28 * (h * h * (1.4 - 0.4 * h));
const curve = Array.from({ length: 21 }, (_, i) => {
  const h = i / 20;
  return `${i ? 'L' : 'M'}${(h * 100).toFixed(1)} ${(curveY(h) * 100).toFixed(2)}`;
}).join('');
// A few ideas per stage for the static drawing: [x, y, colour, opacity]
const T500 = '#6F807C';
const TEAL = '#6FC3B8';
const COPPER = '#D9894A';
const dots: [number, number, string, number][] = [
  [0.03, 0.34, T500, 1], [0.07, 0.52, T500, 1], [0.05, 0.71, T500, 1], [0.11, 0.42, T500, 1], [0.1, 0.8, T500, 1], [0.13, 0.6, T500, 1],
  [0.17, 0.79, T500, 0.25], [0.16, 0.88, T500, 0.25],
  [0.23, 0.38, T500, 1], [0.27, 0.62, '#6FA29A', 1], [0.31, 0.48, '#6FA29A', 1], [0.29, 0.77, T500, 1],
  [0.35, 0.86, T500, 0.25],
  [0.41, 0.46, TEAL, 1], [0.46, 0.66, TEAL, 1], [0.49, 0.53, TEAL, 1],
  [0.53, 0.83, TEAL, 0.25],
  [0.6, 0.5, '#A4A681', 1], [0.66, 0.6, '#A4A681', 1],
  [0.71, 0.88, '#A4A681', 0.25],
];
---
<section class="hero bg-grid" id="top" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow hero-in" style="--d:0">PRODUCT&nbsp;· OPERATING MODEL&nbsp;· COMMERCIALISATION&nbsp;· VENTURE BUILDING&nbsp;· FROM LUXEMBOURG</p>
      <h1 class="hero__title" id="hero-title">
        {words.map((w, i) => <><span class="hero__word" style={`--w:${i}`}>{w}</span>{i < words.length - 1 ? ' ' : ''}</>)}
      </h1>
      <p class="lead hero__support hero-in" style="--d:300ms">Products people use. Operations that cost less to run. Services clients buy. Businesses that grow.</p>
      <p class="lead hero__sub hero-in" style="--d:420ms">Koeos builds the product, the offer and the operating model around technology, from how an organisation works inside to new products, services and businesses in Europe. AI does a growing share of the work.</p>
      <div class="hero__actions hero-in" style="--d:540ms">
        <a class="btn btn--primary" href="#contact">Start a conversation<Arrow /></a>
        <a class="btn btn--secondary" href="#how">See how we work<Arrow /></a>
      </div>
      <p class="hero__small hero-in" style="--d:620ms">Operator-led. We have built, run, sold and invested in companies across Europe, the Middle East, South Asia and the US.</p>
    </div>

    <div class="hero__field" data-hero-field data-gates-wide={gates.join(',')} data-gates-narrow={gates.join(',')}>
      <p class="sr-only" id="hero-field-desc">Illustration of the method: many ideas enter from the left and meet four gates labelled choose, test, build and scale. At each gate about a third are stopped. Those that pass turn from grey to teal to copper and, after the last gate, form a rising line labelled revenue.</p>
      <svg class="hero__static" aria-hidden="true" focusable="false" width="100%" height="100%">
        {gates.map((g, i) => (
          <g>
            <line x1={`${g * 100}%`} x2={`${g * 100}%`} y1="56" y2="92%" stroke="#6F807C" stroke-opacity="0.45" stroke-width="1" />
            <text x={`${g * 100}%`} y="40" text-anchor="middle" class="hero__gate-label">{gateLabels[i]}</text>
          </g>
        ))}
        {dots.map(([x, y, c, o]) => <circle cx={`${x * 100}%`} cy={`${y * 100}%`} r="2.5" fill={c} fill-opacity={o} />)}
        <svg x="74%" y="0" width="24%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="none" overflow="visible">
          <path d={curve} fill="none" stroke="#D9894A" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linecap="round" />
        </svg>
        <text x="98%" y={`${curveY(1) * 100}%`} dy="-14" text-anchor="end" class="hero__rev-label">REVENUE</text>
      </svg>
      <canvas class="hero__canvas" aria-hidden="true"></canvas>
    </div>
  </div>

  <div class="ticker" data-ticker>
    <div class="ticker__viewport">
      <div class="ticker__rail" data-ticker-rail>
        <ul class="ticker__track" aria-label="Capabilities">
          {tags.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </div>
    <button type="button" class="ticker__toggle" aria-pressed="false" data-ticker-toggle hidden>
      <svg class="ticker__icon ticker__icon--pause" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false"><path d="M3 2v8M9 2v8" stroke="currentColor" stroke-width="2" /></svg>
      <svg class="ticker__icon ticker__icon--play" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false"><path d="M3 1.5v9l7-4.5z" fill="currentColor" /></svg>
      <span class="sr-only">Pause moving list</span>
    </button>
  </div>
</section>

<style is:global>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: max(720px, 100svh);
    padding-top: calc(var(--header-h) + var(--s-8));
    background-color: var(--ink-950);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    flex: 1;
    display: grid;
    align-content: center;
  }
  .hero__copy {
    max-width: 680px;
  }
  .hero__eyebrow {
    color: var(--teal-300);
    margin-bottom: var(--s-6);
  }
  .hero__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-hero);
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--text-100);
    text-wrap: balance;
  }
  .hero__word {
    display: inline-block;
  }
  /* Support line: the subhead style, in text-100 */
  .hero__support {
    margin-top: var(--s-6);
    color: var(--text-100);
  }
  .hero__sub {
    margin-top: var(--s-6);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-7);
  }
  .hero__small {
    margin-top: var(--s-5);
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-300);
    max-width: 56ch;
  }

  /* Load sequence: headline word by word, then support line, subhead, buttons, small line */
  .js.motion .hero__word {
    animation: hero-word var(--dur-base) var(--ease-out) both;
    animation-delay: calc(var(--w) * 60ms);
  }
  .js.motion .hero-in {
    animation: hero-word var(--dur-base) var(--ease-out) both;
    animation-delay: var(--d);
  }
  @keyframes hero-word {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  /* A1 field: below the copy at full content width (height 0.6 × width) */
  .hero__field {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 3;
    margin-top: var(--s-7);
  }
  .hero__static,
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__static {
    overflow: visible;
    transition: opacity 1.2s var(--ease-in-out);
  }
  .hero__canvas {
    opacity: 0;
    transition: opacity 1.2s var(--ease-in-out);
  }
  .hero__field.is-live .hero__canvas {
    opacity: 1;
  }
  .hero__field.is-live .hero__static {
    opacity: 0;
  }
  .hero__gate-label {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.12em;
    fill: var(--text-500);
  }
  .hero__rev-label {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.12em;
    fill: var(--copper-400);
  }
  /* Desktop: right column of the hero grid, max 640 × 420, centred on the copy */
  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: center;
    }
    .hero__copy {
      grid-column: 1 / span 7;
      max-width: none;
    }
    .hero__field {
      grid-column: 8 / span 5;
      justify-self: end;
      max-width: 640px;
      aspect-ratio: 640 / 420;
      margin: 0;
    }
  }

  /* Ticker */
  .ticker {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    margin-top: var(--s-6);
    border-top: 1px solid var(--line-700);
    background: rgb(11 17 19 / 0.6);
  }
  .ticker__viewport {
    flex: 1;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 48px, #000 calc(100% - 48px), transparent);
    mask-image: linear-gradient(to right, transparent, #000 48px, #000 calc(100% - 48px), transparent);
  }
  .ticker__rail {
    display: flex;
    width: max-content;
  }
  .ticker__track {
    display: flex;
    flex: none;
  }
  .ticker__track li {
    display: flex;
    align-items: center;
    height: 55px;
    padding-inline: 20px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-300);
    white-space: nowrap;
  }
  .ticker__track li::after {
    content: '';
    width: 5px;
    height: 5px;
    margin-left: 40px;
    background: var(--copper-400);
    transform: rotate(45deg);
    flex: none;
  }
  .motion .ticker__rail {
    animation: ticker var(--ticker-dur, 44s) linear infinite;
  }
  .ticker:hover .ticker__rail,
  .ticker:focus-within .ticker__rail,
  .ticker.is-paused .ticker__rail,
  .ticker.is-offscreen .ticker__rail {
    animation-play-state: paused;
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }
  .ticker__toggle {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-inline: 6px;
    background: transparent;
    border: 1px solid var(--line-700);
    border-radius: 2px;
    color: var(--text-300);
  }
  .ticker__toggle:hover {
    color: var(--text-100);
    border-color: var(--text-300);
  }
  .ticker__icon--play,
  .ticker.is-paused .ticker__icon--pause {
    display: none;
  }
  .ticker.is-paused .ticker__icon--play {
    display: block;
  }
  /* Without motion: one static, wrapped list */
  :root:not(.motion) .ticker__toggle {
    display: none !important;
  }
  :root:not(.motion) .ticker__viewport {
    -webkit-mask-image: none;
    mask-image: none;
  }
  :root:not(.motion) .ticker__rail,
  :root:not(.motion) .ticker__track {
    width: auto;
    flex-wrap: wrap;
  }
  :root:not(.motion) .ticker__rail {
    padding-inline: calc(var(--margin) - 20px);
    padding-block: var(--s-2);
  }
  :root:not(.motion) .ticker__track li {
    height: 40px;
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker__toggle {
      display: none !important;
    }
    .ticker__rail,
    .ticker__track {
      width: auto;
      flex-wrap: wrap;
      animation: none !important;
    }
    .ticker__viewport {
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
</style>
