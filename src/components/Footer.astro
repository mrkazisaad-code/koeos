---
import { CONTACT_EMAIL, LINKEDIN_URL, NAV_LINKS } from '../config/site';
import { SOURCES } from '../data/sources';
interface Props {
  /** Prefix for nav anchors when the footer sits on another page. */
  base?: string;
}
const { base = '' } = Astro.props;
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__cols">
      <div class="site-footer__brand">
        <a class="wordmark" href={`${base}#top`}>KOEOS</a>
        <p>Operator-led. From Luxembourg, for Europe.</p>
      </div>
      <nav class="site-footer__nav" id="footer-nav" aria-label="Footer">
        <ul>
          {NAV_LINKS.map((l) => <li><a href={`${base}${l.href}`}>{l.label}</a></li>)}
        </ul>
      </nav>
      <ul class="site-footer__meta">
        <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
        <li>
          <a class="site-footer__li" href={LINKEDIN_URL} rel="noopener noreferrer" target="_blank" aria-label="Koeos on LinkedIn (opens in a new tab)">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
            <span aria-hidden="true">LinkedIn</span>
          </a>
        </li>
        <li><a href={`${base}#sources`} data-open-sources>Sources for figures</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </div>
    <p class="site-footer__legal">© 2026 Koeos. All rights reserved.</p>

    <noscript>
      <section class="site-footer__sources" id="sources" aria-labelledby="sources-title-nojs">
        <h2 class="dialog__title" id="sources-title-nojs">Sources for figures</h2>
        <ol class="source-list">
          {SOURCES.map((s) => (
            <li id={`source-${s.n}`}>
              <span class="source-list__n">{s.n}</span>
              <span><strong>{s.publisher}</strong>, <a href={s.url} rel="noopener noreferrer">{s.title}</a>, {s.date}. {s.supports}{s.also && <> Also: <a href={s.also.url} rel="noopener noreferrer">{s.also.label}</a>.</>}</span>
            </li>
          ))}
        </ol>
      </section>
    </noscript>
  </div>
</footer>

<dialog class="dialog" id="sources-dialog" aria-labelledby="sources-title" data-sources-dialog>
  <div class="dialog__inner">
    <div class="dialog__head">
      <h2 class="dialog__title" id="sources-title">Sources for figures</h2>
      <button type="button" class="icon-btn" data-dialog-close>
        <span class="sr-only">Close</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.6" fill="none" /></svg>
      </button>
    </div>
    <ol class="source-list">
      {SOURCES.map((s) => (
        <li>
          <span class="source-list__n">{s.n}</span>
          <span><strong>{s.publisher}</strong>, <a href={s.url} rel="noopener noreferrer" target="_blank">{s.title}<span class="sr-only"> (opens in a new tab)</span></a>, {s.date}. {s.supports}{s.also && <> Also: <a href={s.also.url} rel="noopener noreferrer" target="_blank">{s.also.label}<span class="sr-only"> (opens in a new tab)</span></a>.</>}</span>
        </li>
      ))}
    </ol>
  </div>
</dialog>

<style is:global>
  .site-footer {
    background: var(--ink-950);
    border-top: 1px solid var(--line-700);
    padding-block: var(--s-8);
    font-size: 15px;
  }
  .site-footer__cols {
    display: grid;
    gap: var(--s-6);
  }
  .site-footer__brand p {
    margin-top: var(--s-3);
    color: var(--text-300);
  }
  .site-footer ul {
    display: grid;
    gap: var(--s-2);
  }
  .site-footer a:not(.wordmark) {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 32px;
    color: var(--text-300);
    text-decoration: none;
  }
  .site-footer a:not(.wordmark):hover {
    color: var(--text-100);
    text-decoration: underline;
  }
  .site-footer__legal {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--line-700);
    color: var(--text-500);
    font-size: 13px;
  }
  .site-footer__sources {
    margin-top: var(--s-7);
  }
  .site-footer__sources .dialog__title {
    margin-bottom: var(--s-5);
  }
  @media (min-width: 768px) {
    .site-footer__cols {
      grid-template-columns: 5fr 3fr 3fr;
      gap: var(--gutter);
    }
  }
</style>
