---
/**
 * A7 Hub and markets. Outline data is generated at build time by scripts/gen-map.mjs
 * (Natural Earth 1:50m via world-atlas), so no map code ships to the browser.
 */
import map from '../../data/europe-map.json';
interface Props {
  layout: 'wide' | 'compact';
}
const { layout } = Astro.props;
const m = map[layout];
const P = m.points as Record<string, [number, number]>;
const [lx, ly] = P.lu;

type Lbl = { lines: string[]; x: number; y: number; anchor: 'start' | 'middle' | 'end' };
const labels: Record<string, Record<string, Lbl>> = {
  wide: {
    de: { lines: ['GERMANY ·', 'LARGEST ON OUR WATCH'], x: P.de[0] + 12, y: P.de[1] - 4, anchor: 'start' },
    fr: { lines: ['FRANCE'], x: P.fr[0] - 10, y: P.fr[1] + 16, anchor: 'end' },
    nl: { lines: ['NETHERLANDS'], x: P.nl[0], y: P.nl[1] - 12, anchor: 'middle' },
    be: { lines: ['BELGIUM'], x: P.be[0] - 10, y: P.be[1] + 2, anchor: 'end' },
    uk: { lines: ['UNITED KINGDOM'], x: P.uk[0], y: P.uk[1] - 12, anchor: 'middle' },
  },
  compact: {
    de: { lines: ['GERMANY ·', 'LARGEST ON', 'OUR WATCH'], x: m.width - 4, y: P.de[1] - 40, anchor: 'end' },
    fr: { lines: ['FRANCE'], x: P.fr[0] - 8, y: P.fr[1] + 16, anchor: 'end' },
    nl: { lines: ['NETHERLANDS'], x: P.nl[0], y: P.nl[1] - 10, anchor: 'middle' },
    be: { lines: ['BELGIUM'], x: P.be[0] - 9, y: P.be[1] + 3, anchor: 'end' },
    uk: { lines: ['UNITED KINGDOM'], x: P.uk[0], y: P.uk[1] - 12, anchor: 'middle' },
  },
};
const L = labels[layout];

// Quadratic arc bulging north of the straight line
const arc = (to: [number, number], bulge = 0.22, ctrl?: [number, number]) => {
  const [x1, y1] = to;
  const dx = x1 - lx;
  const dy = y1 - ly;
  const len = Math.hypot(dx, dy);
  let nx = -dy / len;
  let ny = dx / len;
  if (ny > 0) {
    nx = -nx;
    ny = -ny;
  }
  const cx = ctrl ? ctrl[0] : (lx + x1) / 2 + nx * len * bulge;
  const cy = ctrl ? ctrl[1] : (ly + y1) / 2 + ny * len * bulge;
  return { d: `M${lx} ${ly}Q${cx.toFixed(1)} ${cy.toFixed(1)} ${x1} ${y1}`, c: [cx, cy] as [number, number] };
};
// Where a quadratic leaves the frame (used to place the outbound labels)
const exitPoint = (to: [number, number], c: [number, number]) => {
  for (let t = 0; t <= 1; t += 0.005) {
    const x = (1 - t) ** 2 * lx + 2 * (1 - t) * t * c[0] + t * t * to[0];
    const y = (1 - t) ** 2 * ly + 2 * (1 - t) * t * c[1] + t * t * to[1];
    if (x < 0 || y < 0 || x > m.width || y > m.height) return [x, y];
  }
  return to;
};

const markets = ['de', 'fr', 'nl', 'be', 'uk'].map((k, i) => ({ k, i, ...arc(P[k], k === 'be' ? 0.4 : k === 'uk' ? 0.12 : 0.22) }));
const emea = arc(P.emea, 0.12);
// West across the Atlantic edge, passing south of the UK label
const us = arc(P.us, 0, [lx - 0.39 * m.width, ly + 0.107 * m.height]);
const emeaExit = exitPoint(P.emea, emea.c);
const usExit = exitPoint(P.us, us.c);
const fs = layout === 'wide' ? 12 : 11;
const emeaLbl = { x: m.width - 6, y: Math.min(emeaExit[1] + 34, m.height - 8) };
const usLbl = { x: 6, y: usExit[1] - 10 };
const id = `map-${layout}`;
---
<svg class={`map map--${layout}`} viewBox={`0 0 ${m.width} ${m.height}`} role="img" aria-label="Map of Europe with Luxembourg as the hub. Lines run from Luxembourg to Germany, the largest market on our watch, and to France, the Netherlands, Belgium and the United Kingdom. Dashed lines extend south-east to EMEA, next, on evidence, and west to the US, later." data-map style={`--fs:${fs}px`}>
  <defs>
    <mask id={`${id}-emea`} maskUnits="userSpaceOnUse" x="-40" y="-40" width={m.width + 80} height={m.height + 80}>
      <path d={emea.d} pathLength="1" class="map__mask-path" style="--i:0" />
    </mask>
    <mask id={`${id}-us`} maskUnits="userSpaceOnUse" x="-40" y="-40" width={m.width + 80} height={m.height + 80}>
      <path d={us.d} pathLength="1" class="map__mask-path" style="--i:1" />
    </mask>
  </defs>
  <path class="map__outline" d={m.outline} />
  {markets.map((a) => (
    <path class="map__arc" d={a.d} pathLength="1" style={`--i:${a.i}`} />
  ))}
  <path class="map__arc map__arc--out" d={emea.d} mask={`url(#${id}-emea)`} />
  <path class="map__arc map__arc--out" d={us.d} mask={`url(#${id}-us)`} />

  {markets.map((a) => (
    <g class="map__end" style={`--i:${a.i}`}>
      <circle cx={P[a.k][0]} cy={P[a.k][1]} r={a.k === 'de' ? 5 : 3} class={a.k === 'de' ? 'map__end-dot map__end-dot--de' : 'map__end-dot'} />
      <text x={L[a.k].x} y={L[a.k].y} text-anchor={L[a.k].anchor} class="map__label">
        {L[a.k].lines.map((t, j) => <tspan x={L[a.k].x} dy={j === 0 ? 0 : fs + 3}>{t}</tspan>)}
      </text>
    </g>
  ))}
  <g class="map__out-label" style="--i:0">
    <text x={emeaLbl.x} y={emeaLbl.y} text-anchor="end" class="map__label map__label--muted">EMEA · NEXT, ON EVIDENCE</text>
  </g>
  <g class="map__out-label" style="--i:1">
    <text x={usLbl.x} y={usLbl.y} text-anchor="start" class="map__label map__label--muted">US · LATER</text>
  </g>

  <g class="map__hub">
    <circle cx={lx} cy={ly} r="7" class="map__pulse" />
    <circle cx={lx} cy={ly} r="6" class="map__hub-dot" />
  </g>
</svg>
