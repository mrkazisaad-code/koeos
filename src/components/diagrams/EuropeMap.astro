---
/**
 * A7 From Luxembourg, into Europe. Outline data is generated at build time by scripts/gen-map.mjs
 * (Natural Earth via world-atlas), so no map code ships to the browser. Arc end points are
 * decorative: they sit away from capital cities and carry roles, never country names.
 */
import map from '../../data/europe-map.json';
interface Props {
  layout: 'wide' | 'compact';
}
const { layout } = Astro.props;
const m = map[layout];
const P = m.points as Record<string, [number, number]>;
const [lx, ly] = P.lu;

type Anchor = 'start' | 'middle' | 'end';
type Lbl = { text: string; dx: number; dy: number; anchor: Anchor };
const ARCS: { key: string; text: string }[] = [
  { key: 'customers', text: 'CUSTOMERS' },
  { key: 'capital', text: 'CAPITAL' },
  { key: 'partners', text: 'PARTNERS' },
  { key: 'research', text: 'RESEARCH' },
  { key: 'publicMarkets', text: 'PUBLIC MARKETS' },
];
// Label offsets from each end point, per composition, so labels stay inside the frame
const offsets: Record<string, Record<string, Omit<Lbl, 'text'>>> = {
  wide: {
    customers: { dx: 10, dy: 4, anchor: 'start' },
    capital: { dx: -10, dy: 4, anchor: 'end' },
    partners: { dx: -10, dy: 4, anchor: 'end' },
    research: { dx: 10, dy: 4, anchor: 'start' },
    publicMarkets: { dx: 10, dy: 4, anchor: 'start' },
  },
  compact: {
    customers: { dx: -8, dy: -9, anchor: 'end' },
    capital: { dx: 0, dy: -10, anchor: 'middle' },
    partners: { dx: -8, dy: 4, anchor: 'end' },
    research: { dx: 8, dy: 4, anchor: 'start' },
    publicMarkets: { dx: 45, dy: 18, anchor: 'end' },
  },
};

// Quadratic arc bulging north of the straight line
const arc = (to: [number, number], bulge = 0.22) => {
  const [x1, y1] = to;
  const dx = x1 - lx;
  const dy = y1 - ly;
  const len = Math.hypot(dx, dy);
  let nx = -dy / len;
  let ny = dx / len;
  if (ny > 0) {
    nx = -nx;
    ny = -ny;
  }
  const cx = (lx + x1) / 2 + nx * len * bulge;
  const cy = (ly + y1) / 2 + ny * len * bulge;
  return { d: `M${lx} ${ly}Q${cx.toFixed(1)} ${cy.toFixed(1)} ${x1} ${y1}`, c: [cx, cy] as [number, number] };
};
// Where a quadratic leaves the frame (used to place the outbound label)
const exitPoint = (to: [number, number], c: [number, number]) => {
  for (let t = 0; t <= 1; t += 0.005) {
    const x = (1 - t) ** 2 * lx + 2 * (1 - t) * t * c[0] + t * t * to[0];
    const y = (1 - t) ** 2 * ly + 2 * (1 - t) * t * c[1] + t * t * to[1];
    if (x < 0 || y < 0 || x > m.width || y > m.height) return [x, y];
  }
  return to;
};

const arcs = ARCS.map((a, i) => ({ ...a, i, p: P[a.key], o: offsets[layout][a.key], ...arc(P[a.key]) }));
// Leaves through the bottom edge, between the partners and public-markets arcs
const beyond = arc(P.beyond, 0.08);
const beyondExit = exitPoint(P.beyond, beyond.c);
const fs = layout === 'wide' ? 12 : 11;
const beyondLbl = { x: Math.min(beyondExit[0], m.width) + 10, y: m.height - 12 };
const id = `map-${layout}`;
---
<svg class={`map map--${layout}`} viewBox={`0 0 ${m.width} ${m.height}`} role="img" aria-label="Map of Europe with Luxembourg as the base. Five lines run from Luxembourg into Europe, labelled customers, capital, partners, research and public markets. One dashed line leaves the map, labelled beyond Europe." data-map style={`--fs:${fs}px`}>
  <defs>
    <mask id={`${id}-beyond`} maskUnits="userSpaceOnUse" x="-40" y="-40" width={m.width + 80} height={m.height + 80}>
      <path d={beyond.d} pathLength="1" class="map__mask-path" style="--i:0" />
    </mask>
  </defs>
  <path class="map__outline" d={m.outline} />
  {arcs.map((a) => (
    <path class="map__arc" d={a.d} pathLength="1" style={`--i:${a.i}`} />
  ))}
  <path class="map__arc map__arc--out" d={beyond.d} mask={`url(#${id}-beyond)`} />

  {arcs.map((a) => (
    <g class="map__end" style={`--i:${a.i}`}>
      <circle cx={a.p[0]} cy={a.p[1]} r="3" class="map__end-dot" />
      <text x={a.p[0] + a.o.dx} y={a.p[1] + a.o.dy} text-anchor={a.o.anchor} class="map__label">{a.text}</text>
    </g>
  ))}
  <g class="map__out-label" style="--i:0">
    <text x={beyondLbl.x} y={beyondLbl.y} text-anchor="start" class="map__label map__label--muted">BEYOND EUROPE</text>
  </g>

  <g class="map__hub">
    <circle cx={lx} cy={ly} r="7" class="map__pulse" />
    <circle cx={lx} cy={ly} r="6" class="map__hub-dot" />
    <text x={lx - 12} y={ly + 4} text-anchor="end" class="map__label map__label--hub">LUXEMBOURG · BASE</text>
  </g>
</svg>
