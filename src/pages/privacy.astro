---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { CONTACT_EMAIL, SITE_URL } from '../config/site';
// Approved by the owner (Oct 2026). Revisit the delivery and IP lines once the form provider is chosen.
---
<Base title="Privacy notice — Koeos" description="How Koeos handles the details you send through the contact form." canonical={new URL('/privacy/', SITE_URL).href} socialTitle="Privacy notice — Koeos" socialDescription="How Koeos handles the details you send through the contact form.">
  <header class="site-header is-scrolled">
    <div class="container site-header__bar">
      <a class="wordmark" href="/">KOEOS</a>
    </div>
  </header>
  <main id="main" class="section privacy">
    <div class="container">
      <p class="eyebrow">PRIVACY</p>
      <h1 class="h2">Privacy notice</h1>
      <div class="privacy__body">
        <h2 class="h3">Who we are</h2>
        <p>Koeos, Luxembourg, is responsible for the personal data you send us through this website. You can reach us at <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
        <h2 class="h3">What we collect</h2>
        <p>Only what you type into the contact form: your name, organisation, email address, where you are starting from (if you choose to say) and your message. Your IP address is used briefly to limit repeated submissions and is not stored with your message.</p>
        <h2 class="h3">Why we use it</h2>
        <p>We use your details only to reply to you. The legal basis is our legitimate interest in answering an enquiry you chose to send, or steps you ask us to take before a contract.</p>
        <h2 class="h3">How long we keep it</h2>
        <p>The website does not store form submissions. Your message is delivered to our mailbox and kept only as long as the conversation needs, then deleted.</p>
        <h2 class="h3">Cookies and tracking</h2>
        <p>This website sets no cookies and uses no third-party trackers or analytics. Fonts are served from our own domain.</p>
        <h2 class="h3">Your rights</h2>
        <p>You can ask to see, correct or delete your data, or object to its use, by emailing <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. You can also complain to the Luxembourg data protection authority, the Commission nationale pour la protection des données (CNPD).</p>
        <p><a href="/">Back to the home page</a></p>
      </div>
    </div>
  </main>
  <Footer base="/" />
  <script>
    import '../scripts/sources-dialog';
  </script>
</Base>

<style>
  .privacy {
    padding-top: calc(var(--header-h) + var(--s-9));
  }
  .privacy .h2 {
    margin-top: var(--s-5);
  }
  .privacy__body {
    max-width: 62ch;
    margin-top: var(--s-7);
    display: grid;
    gap: var(--s-4);
  }
  .privacy__body .h3 {
    margin-top: var(--s-5);
  }
</style>
